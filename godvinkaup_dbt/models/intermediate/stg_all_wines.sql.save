                    WHEN wines.taste_group = '02LS' THEN 'Létt og sætt'
                    WHEN wines.taste_group = '02T' THEN 'Kröftugt og ósætt'
                    WHEN wines.taste_group = '02LM' THEN 'Létt og millisætt'
                    WHEN wines.taste_group = '02MS' THEN 'Meðalfyllt og sætt'
                    WHEN wines.taste_group = '02TS' THEN 'Kröftugt og sætt'
                    WHEN wines.taste_group = '02X' THEN 'Eftirréttarvín - sætvín'
                    WHEN wines.taste_group = '02L' THEN 'Létt og ósætt'
                    WHEN wines.taste_group = '02M' THEN 'Meðalfyllt og ósætt'
                    WHEN wines.taste_group = '02MM' THEN 'Kröftugt og ósætt'
                    WHEN wines.taste_group = '03M' THEN 'Millisætt'
                    WHEN wines.taste_group = '03S' THEN 'Sætt'
                    WHEN wines.taste_group = '03' THEN 'Ósætt'
                    WHEN wines.taste_group = '04' THEN 'Ósætt'
                    WHEN wines.taste_group = '04M' THEN 'Millisætt'
                    WHEN wines.taste_group = '04S' THEN 'Sætt'
                END AS taste_group
            , wines.category
            , wines.food_pairing
            , wines.producer
            , wines.carbon_footprint
            , wines.closing
            , wines.is_organic
            , coalesce(wines_links.link, wines.link) as link
            , wines.batch_id
            , wines.seller
            , wines_desc.description
        FROM {{ source('landing', 'white_wines') }} wines
        left join {{ source('landing', 'atvr_wine_descriptions') }} wines_desc on (wines.id = wines_desc.wine_id)
	left join {{ source('landing', 'atvr_wine_links')  }} wines_links on (wines.id = wines_links.wine_id)
        where wines.container_type in ('FL.', 'PET')
),

