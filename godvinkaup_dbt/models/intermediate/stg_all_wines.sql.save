{{
	config(
            materialized='table'
        )
}}

WITH red_wines AS (
    SELECT    wines.id
            , wines.name
            , wines.volume
            , wines.abv
            , wines.price
            , wines.country
            , wines.origin_place
            , wines.origin_district
            , wines.grapes
            , wines.produced_year
            , CASE
                    WHEN wines.container_type = 'PET' THEN 'Plast'
                    WHEN wines.container_type = 'STK.' THEN 'Stykki'
                    WHEN wines.container_type = 'DS.' THEN 'Dós'
                    WHEN wines.container_type = 'FL.' THEN 'Flaska'
                    ELSE wines.container_type
                END AS container_type
            , wines.first_on_market
            , CASE
                    WHEN wines.taste_group = '01TM' THEN 'Kröftugt og millisætt'
                    WHEN wines.taste_group = '01MM' THEN 'Meðalfyllt og millisætt'
                    WHEN wines.taste_group = '01TS' THEN 'Kröftugt og sætt'
                    WHEN wines.taste_group = '01MS' THEN 'Meðalfyllt og sætt'
                    WHEN wines.taste_group = '01LM' THEN 'Létt og millisætt'
                    WHEN wines.taste_group = '01X' THEN 'Eftirréttarvín - sætvín'
                    WHEN wines.taste_group = '01LS' THEN 'Létt og sætt'
                    WHEN wines.taste_group = '01L' THEN 'Létt og ósætt'
                    WHEN wines.taste_group = '01M' THEN 'Meðalfyllt og ósætt'
                    WHEN wines.taste_group = '01T' THEN 'Kröftugt og ósætt'
                    WHEN wines.taste_group = '02TM' THEN 'Kröftugt og millisætt'
                    WHEN wines.taste_group = '02LS' THEN 'Létt og sætt'
                    WHEN wines.taste_group = '02T' THEN 'Kröftugt og ósætt'
                    WHEN wines.taste_group = '02LM' THEN 'Létt og millisætt'
                    WHEN wines.taste_group = '02MS' THEN 'Meðalfyllt og sætt'
                    WHEN wines.taste_group = '02TS' THEN 'Kröftugt og sætt'
                    WHEN wines.taste_group = '02X' THEN 'Eftirréttarvín - sætvín'
                    WHEN wines.taste_group = '02L' THEN 'Létt og ósætt'
                    WHEN wines.taste_group = '02M' THEN 'Meðalfyllt og ósætt'
                    WHEN wines.taste_group = '02MM' THEN 'Kröftugt og ósætt'
                    WHEN wines.taste_group = '03M' THEN 'Millisætt'
                    WHEN wines.taste_group = '03S' THEN 'Sætt'
                    WHEN wines.taste_group = '03' THEN 'Ósætt'
                    WHEN wines.taste_group = '04' THEN 'Ósætt'
                    WHEN wines.taste_group = '04M' THEN 'Millisætt'
                    WHEN wines.taste_group = '04S' THEN 'Sætt'
                END AS taste_group
            , wines.category
            , wines.food_pairing
            , wines.producer
            , wines.carbon_footprint
            , wines.closing
            , wines.is_organic
            , wines.link
            , wines.batch_id
            , wines.seller
            , wines_desc.description
        FROM {{ source('landing', 'red_wines') }} wines
        left join {{ source('landing', 'atvr_wine_descriptions') }} wines_desc on (wines.id = wines_desc.wine_id)
	
        where wines.container_type in ('FL.', 'PET')
),
