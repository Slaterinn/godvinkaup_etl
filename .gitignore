
# Ignore everything at repository root
/*

# Repository metadata
!.gitignore
!README.md
!Dockerfile
!docker-compose.yml
!AGENTS.md

# Documentation
!docs/
!docs/**

# Helper scripts
!scripts/
!scripts/**

# Airflow
!dags/
!dags/**

# dbt
!godvinkaup_dbt/
!godvinkaup_dbt/**

# Ignore Python cache
**/__pycache__/
**/*.py[cod]

# Ignore dbt build artifacts
godvinkaup_dbt/target/
godvinkaup_dbt/logs/
godvinkaup_dbt/dbt_packages/

# Local secrets
.env
.env.*
!.env.example

# Editor backup files
*.save
*.save.*
*.bak
*.tmp
*~
